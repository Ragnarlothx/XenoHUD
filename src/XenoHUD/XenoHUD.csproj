<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>XenoHUD</AssemblyName>
    <RootNamespace>XenoHUD</RootNamespace>
    <Version>0.1.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <WebView2EnableCsWinRTProjection>false</WebView2EnableCsWinRTProjection>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <!-- keep this PC's folder paths out of the exe and .pdb -->
    <PathMap>$(MSBuildProjectDirectory)=src</PathMap>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <!-- 0.9.5+ reads CPU sensors through PawnIO only if the user already installed it.
         We never install a driver ourselves. GPU sensors (NVAPI / ADL) need no driver. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <!-- The web UI ships as loose files next to the exe so it can be edited without a rebuild. -->
  <ItemGroup>
    <Content Include="..\..\web\**\*" LinkBase="web" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
